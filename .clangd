# clangd reads compile_commands.json from the project root. cmake-tools.nvim
# links it there from the selected preset's build folder on every configure.
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: None # no hints for symbols that only come in through indirect includes
  ClangTidy:
    FastCheckFilter: Loose # checks are listed in .clang-tidy
