{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64 (Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug",      "displayName": "Debug",          "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "release",    "displayName": "Release",        "configurePreset": "msvc", "configuration": "Release" },
    { "name": "relwithdbg", "displayName": "RelWithDebInfo", "configurePreset": "msvc", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "debug",      "configurePreset": "msvc", "configuration": "Debug",          "output": { "outputOnFailure": true } },
    { "name": "release",    "configurePreset": "msvc", "configuration": "Release",        "output": { "outputOnFailure": true } },
    { "name": "relwithdbg", "configurePreset": "msvc", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
